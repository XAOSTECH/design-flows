		"editor.tokenColorCustomizations": {
			"comments": "#ffe6ea80",
			"strings": "#ffff3d",
			"keywords": "#ffc0ca",
			"numbers": "#ffff29",
			"types": "#fff2f4",
			"functions": "#ffff66",
			"variables": "#ffffff",
			"textMateRules": [
				{
					"scope": ["entity.name.function", "support.function"],
					"settings": { "foreground": "#ffff66" }
				},
				{
					"scope": ["entity.name.type", "support.type", "support.class"],
					"settings": { "foreground": "#fff2f4" }
				},
				{
					"scope": ["keyword", "storage.type", "storage.modifier"],
					"settings": { "foreground": "#ffc0ca" }
				},
				{
					"scope": ["string", "string.quoted"],
					"settings": { "foreground": "#ffff3d" }
				},
				{
					"scope": ["constant.numeric"],
					"settings": { "foreground": "#ffff29" }
				},
				{
					"scope": ["variable.parameter", "variable.other"],
					"settings": { "foreground": "#ffffff" }
				},
				{
					"scope": ["comment", "punctuation.definition.comment"],
					"settings": { "foreground": "#ffe6ea80", "fontStyle": "italic" }
				},
				{
					"scope": ["entity.name.tag"],
					"settings": { "foreground": "#ffcdd4" }
				},
				{
					"scope": ["entity.other.attribute-name"],
					"settings": { "foreground": "#ffff4c" }
				},
				{
					"scope": ["punctuation", "meta.brace"],
					"settings": { "foreground": "#fff2f4" }
				},
				{
					"scope": ["constant.language", "support.constant"],
					"settings": { "foreground": "#ffff00" }
				},
				{
					"scope": ["markup.heading", "entity.name.section"],
					"settings": { "foreground": "#c0fff4" }
				},
				{
					"scope": ["markup.bold"],
					"settings": { "foreground": "#ffe185", "fontStyle": "bold" }
				}
			]
